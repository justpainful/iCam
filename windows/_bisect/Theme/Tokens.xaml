<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        iCam's own tokens, layered on top of the Windows 11 theme resources
        rather than replacing them.

        The rules:
        - Mica is the window's material. It is set on the window, once.
        - Acrylic is only for transient surfaces: flyouts, menus, the inspector
          while it is animating. Never for a long-lived panel.
        - The preview is the brightest thing in the window at all times, so
          every surface here sits underneath it in value.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- The area behind the video. Genuinely black, so letterbox bars
                 read as absence rather than as another panel. -->
            <SolidColorBrush x:Key="ICamStageBrush" Color="#000000" />
            <SolidColorBrush x:Key="ICamPanelBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ICamHairlineBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ICamRecordBrush" Color="#FF3B30" />
            <SolidColorBrush x:Key="ICamConnectedBrush" Color="#30D158" />
            <SolidColorBrush x:Key="ICamWarningBrush" Color="#FFB340" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ICamStageBrush" Color="#000000" />
            <SolidColorBrush x:Key="ICamPanelBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="ICamHairlineBrush" Color="#14000000" />
            <SolidColorBrush x:Key="ICamRecordBrush" Color="#D70015" />
            <SolidColorBrush x:Key="ICamConnectedBrush" Color="#248A3D" />
            <SolidColorBrush x:Key="ICamWarningBrush" Color="#B25000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ICamStageBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ICamPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ICamHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ICamRecordBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ICamConnectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ICamWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="ICamPanelCorner">8</x:Double>
    <x:Double x:Key="ICamGutter">16</x:Double>
    <Thickness x:Key="ICamPanelPadding">16</Thickness>
    <Thickness x:Key="ICamRowSpacing">0,0,0,12</Thickness>

    <!-- One readout style, so every live number in the window lines up and
         none of them make the layout twitch as digits change. -->
    <Style x:Key="ICamReadoutTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <Style x:Key="ICamSectionHeaderStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="ICamPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ICamPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ICamHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

</ResourceDictionary>
