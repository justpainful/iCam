<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ICam.App.Views.CameraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <Grid Padding="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ============ Stage ============ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Device line. One row, and only what a person needs at a glance. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10"
                        Margin="0,0,0,10" VerticalAlignment="Center">
                <TextBlock x:Name="DeviceName" Text="No iPhone connected"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border VerticalAlignment="Center" CornerRadius="10" Padding="8,2"
                        Background="{ThemeResource ICamPanelBrush}"
                        x:Name="DeviceBadge" Visibility="Collapsed">
                    <TextBlock x:Name="DeviceSummary"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- The picture. Black behind it, so letterbox bars read as absence
                 rather than as another panel. -->
            <Border Grid.Row="1" CornerRadius="8" Background="{ThemeResource ICamStageBrush}"
                    BorderBrush="{ThemeResource ICamHairlineBrush}" BorderThickness="1">
                <Grid>
                    <!-- The window draws the frames itself rather than letting
                         the player present them. That is what lets the preview
                         show the graded picture, and exactly the one being sent
                         to iCam Camera rather than a prettier local copy. -->
                    <canvas:CanvasControl x:Name="Preview"
                                          ClearColor="#000000"
                                          Draw="OnPreviewDraw" />

                    <!-- Every empty state is designed. This one tells the user
                         exactly what to do next. -->
                    <StackPanel x:Name="EmptyState" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8EA;" FontSize="34"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No iPhone connected"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap"
                                   Text="Open iCam on your iPhone. Your devices should find each other automatically." />
                        <HyperlinkButton x:Name="ConnectHelp" Content="Connect by address"
                                         HorizontalAlignment="Center" Click="OnConnectHelpClick" />
                    </StackPanel>

                    <!-- Recording readout, over the picture only while it means
                         something. -->
                    <Border x:Name="RecordingChip" Visibility="Collapsed"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="12" Padding="10,5" CornerRadius="12"
                            Background="{ThemeResource ICamPanelBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="8" Height="8"
                                     Fill="{ThemeResource ICamRecordBrush}" />
                            <TextBlock x:Name="RecordingElapsed" Text="00:00"
                                       Style="{StaticResource ICamReadoutTextStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Two actions, centred, nothing else competing with them. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button x:Name="PhotoButton" Click="OnTakePhoto" IsEnabled="False"
                        Padding="18,9">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE722;" FontSize="15" />
                        <TextBlock Text="Take Photo" />
                    </StackPanel>
                </Button>

                <Button x:Name="RecordButton" Click="OnToggleRecording" IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" Padding="18,9">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="RecordGlyph" Width="10" Height="10" Fill="White" />
                        <TextBlock x:Name="RecordLabel" Text="Record" />
                    </StackPanel>
                </Button>

                <primitives:ToggleButton x:Name="StreamToggle" Click="OnToggleStreaming" IsEnabled="False"
                              Padding="18,9">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE714;" FontSize="15" />
                        <TextBlock Text="iCam Camera" />
                    </StackPanel>
                </primitives:ToggleButton>
            </StackPanel>
        </Grid>

        <!-- ============ Inspector ============ -->
        <Border Grid.Column="1" Width="308" Margin="16,0,0,0"
                Style="{StaticResource ICamPanelStyle}" Padding="0">
            <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="Inspector" IsEnabled="False"
                                HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="18">

                    <TextBlock Text="CAMERA" Style="{StaticResource ICamSectionHeaderStyle}" />

                    <!-- Lens. The contents come from the phone, so an iPhone with
                         one camera shows one option and one with three shows
                         three. Nothing is drawn for a lens that is not there. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Lens" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox x:Name="LensPicker" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnLensChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Resolution" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox x:Name="ResolutionPicker" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnResolutionChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Frame Rate" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox x:Name="FrameRatePicker" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnFrameRateChanged" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Zoom" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="ZoomReadout" Text="1.0×"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource ICamReadoutTextStyle}" />
                        </Grid>
                        <Slider x:Name="ZoomSlider" Minimum="1" Maximum="6"
                                StepFrequency="0.1" ValueChanged="OnZoomChanged" />
                    </StackPanel>

                    <TextBlock Text="EXPOSURE" Style="{StaticResource ICamSectionHeaderStyle}" />

                    <StackPanel Spacing="6">
                        <ComboBox x:Name="ExposureModePicker" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnExposureModeChanged">
                            <ComboBoxItem Content="Auto" Tag="auto" />
                            <ComboBoxItem Content="Manual" Tag="manual" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="AutoExposurePanel" Spacing="6">
                        <Grid>
                            <TextBlock Text="Exposure Compensation"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="EvReadout" Text="0.0 EV"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource ICamReadoutTextStyle}" />
                        </Grid>
                        <Slider x:Name="EvSlider" Minimum="-3" Maximum="3" StepFrequency="0.1"
                                ValueChanged="OnEvChanged" />
                    </StackPanel>

                    <StackPanel x:Name="ManualExposurePanel" Spacing="14" Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="ISO" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="IsoReadout" Text="100"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Slider x:Name="IsoSlider" Minimum="20" Maximum="3200"
                                    ValueChanged="OnIsoChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Shutter" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="ShutterReadout" Text="1/120"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Slider x:Name="ShutterSlider" Minimum="250" Maximum="100000"
                                    ValueChanged="OnShutterChanged" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="COLOUR" Style="{StaticResource ICamSectionHeaderStyle}" />

                    <ComboBox x:Name="WhiteBalanceModePicker" HorizontalAlignment="Stretch"
                              SelectionChanged="OnWhiteBalanceModeChanged">
                        <ComboBoxItem Content="Auto" Tag="auto" />
                        <ComboBoxItem Content="Manual" Tag="manual" />
                    </ComboBox>

                    <StackPanel x:Name="ManualWhiteBalancePanel" Spacing="6"
                                Visibility="Collapsed">
                        <Grid>
                            <TextBlock Text="Temperature"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="TemperatureReadout" Text="5000 K"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource ICamReadoutTextStyle}" />
                        </Grid>
                        <Slider x:Name="TemperatureSlider" Minimum="2000" Maximum="10000"
                                StepFrequency="50" ValueChanged="OnTemperatureChanged" />
                    </StackPanel>

                    <TextBlock Text="FOCUS" Style="{StaticResource ICamSectionHeaderStyle}" />

                    <ComboBox x:Name="FocusModePicker" HorizontalAlignment="Stretch"
                              SelectionChanged="OnFocusModeChanged">
                        <ComboBoxItem Content="Continuous" Tag="continuous" />
                        <ComboBoxItem Content="Single" Tag="single" />
                        <ComboBoxItem Content="Manual" Tag="manual" />
                    </ComboBox>

                    <!-- The picture, as opposed to the camera. Everything above
                         this point asks the iPhone to do something; everything
                         in here happens on this computer, on the way to the
                         preview and to iCam Camera. -->
                    <Grid>
                        <TextBlock Text="IMAGE" Style="{StaticResource ICamSectionHeaderStyle}" />
                        <HyperlinkButton x:Name="ImageReset" Content="Reset" Padding="0"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Click="OnResetImage" />
                    </Grid>

                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Brightness"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="BrightnessReadout" Text="0.00"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Slider x:Name="BrightnessSlider" Minimum="-1" Maximum="1"
                                    StepFrequency="0.05" ValueChanged="OnBrightnessChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Contrast"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="ContrastReadout" Text="0.00"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Slider x:Name="ContrastSlider" Minimum="-1" Maximum="1"
                                    StepFrequency="0.05" ValueChanged="OnContrastChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Saturation"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="SaturationReadout" Text="0.00"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Slider x:Name="SaturationSlider" Minimum="-1" Maximum="1"
                                    StepFrequency="0.05" ValueChanged="OnSaturationChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Warmth"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="WarmthReadout" Text="0.00"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Slider x:Name="WarmthSlider" Minimum="-1" Maximum="1"
                                    StepFrequency="0.05" ValueChanged="OnWarmthChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Sharpness"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="SharpnessReadout" Text="0.00"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Slider x:Name="SharpnessSlider" Minimum="-1" Maximum="1"
                                    StepFrequency="0.05" ValueChanged="OnSharpnessChanged" />
                        </StackPanel>

                        <!-- A switch first, like the tool this one replaces:
                             on means a strength that flatters, off means off.
                             The level appears only once it is on, for whoever
                             wants finer control than a switch can give. -->
                        <ToggleSwitch x:Name="LowLightToggle" Header="Low Light Boost"
                                      Toggled="OnLowLightToggled" />
                        <StackPanel x:Name="LowLightLevelPanel" Spacing="6"
                                    Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="Boost Strength"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="LowLightReadout" Text="60%"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Slider x:Name="LowLightSlider" Minimum="0.05" Maximum="1"
                                    StepFrequency="0.05" ValueChanged="OnLowLightChanged" />
                        </StackPanel>

                        <ToggleSwitch x:Name="BeautyToggle" Header="Beauty"
                                      Toggled="OnBeautyToggled" />
                        <StackPanel x:Name="BeautyLevelPanel" Spacing="6"
                                    Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="Smoothing Strength"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="BeautyReadout" Text="60%"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Slider x:Name="BeautySlider" Minimum="0.05" Maximum="1"
                                    StepFrequency="0.05" ValueChanged="OnBeautyChanged" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="These change the preview and iCam Camera. The recording on your iPhone keeps the untouched picture." />

                    <ToggleSwitch x:Name="TorchToggle" Header="Torch"
                                  Toggled="OnTorchToggled" />

                    <!-- Mirroring changes the *stream*, on the phone. The
                         preview shows exactly what the call receives, so it
                         flips too — one picture, not two opinions of it. -->
                    <ToggleSwitch x:Name="MirrorToggle" Header="Mirror"
                                  Toggled="OnMirrorToggled" />

                    <!-- Temperature is a state, never a number. iOS publishes no
                         sensor for one, so iCam does not invent a reading. -->
                    <Border Style="{StaticResource ICamPanelStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Battery"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="BatteryReadout" Text="—"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Temperature"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="ThermalReadout" Text="—"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Storage"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="StorageReadout" Text="—"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ICamReadoutTextStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ContentControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
