<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ICam.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource ICamPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="THIS COMPUTER"
                               Style="{StaticResource ICamSectionHeaderStyle}" />
                    <Grid>
                        <TextBlock Text="Name" />
                        <TextBlock x:Name="ComputerName" HorizontalAlignment="Right"
                                   Style="{StaticResource ICamReadoutTextStyle}" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Listening on" />
                        <TextBlock x:Name="ListenPort" HorizontalAlignment="Right"
                                   Style="{StaticResource ICamReadoutTextStyle}" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Visible on the network" />
                        <TextBlock x:Name="AdvertiseState" HorizontalAlignment="Right"
                                   Style="{StaticResource ICamReadoutTextStyle}" />
                    </Grid>

                    <!-- Discovery can be blocked by a network profile or by
                         policy. Saying so, with the way around it, beats an
                         empty list that never explains itself. -->
                    <InfoBar x:Name="DiscoveryWarning" IsOpen="False" Severity="Warning"
                             IsClosable="False"
                             Title="Your iPhone may not find this computer automatically"
                             Message="You can still connect by entering this address on the iPhone." />

                    <Grid>
                        <TextBlock Text="Address for manual connection" />
                        <TextBlock x:Name="AddressText" HorizontalAlignment="Right"
                                   Style="{StaticResource ICamReadoutTextStyle}"
                                   IsTextSelectionEnabled="True" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ICamPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="CONNECTED"
                               Style="{StaticResource ICamSectionHeaderStyle}" />
                    <StackPanel x:Name="ConnectedList" Spacing="10" />
                    <TextBlock x:Name="NoneConnected"
                               Text="No iPhone is connected right now."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ICamPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="PAIRED"
                               Style="{StaticResource ICamSectionHeaderStyle}" />
                    <StackPanel x:Name="PairedList" Spacing="10" />
                    <TextBlock x:Name="NonePaired"
                               Text="No iPhones are paired with this computer yet."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Forgetting an iPhone removes its access to this computer. It will need to pair again." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
