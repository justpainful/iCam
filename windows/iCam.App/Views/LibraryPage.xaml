<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ICam.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <Grid Padding="24">
        <!-- Every empty state is designed. This one explains what will appear
             here, and reassures the reader about where the good copy lives. -->
        <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="440">
            <FontIcon Glyph="&#xE8B7;" FontSize="34"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Nothing saved on this computer yet"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Text="Photos and recordings you capture will appear here. Your iPhone always keeps the full-quality copy, even when this computer keeps one too." />
        </StackPanel>
    </Grid>
</Page>
